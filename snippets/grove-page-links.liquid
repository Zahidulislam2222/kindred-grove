{%- comment -%}Shared navigation is owned by merchant page pickers. Only configured pages are linked.{%- endcomment -%}
<a href="{{ routes.all_products_collection_url }}"{% if template.name == 'collection' %} aria-current="page"{% endif %}>{{ 'grove.shop' | t }}</a>
{%- assign page_keys = 'storefront_story_page,storefront_recipes_page,storefront_faq_page,storefront_contact_page' | split: ',' -%}
{%- for key in page_keys -%}
  {%- assign destination = settings[key] -%}
  {%- if destination != blank -%}
    <a href="{{ destination.url }}"{% if page.id == destination.id %} aria-current="page"{% endif %}>{{ destination.title | escape }}</a>
  {%- endif -%}
{%- endfor -%}
{%- if extended -%}
  {%- assign extra_keys = 'storefront_shipping_page,storefront_quiz_page,storefront_wholesale_page' | split: ',' -%}
  {%- for key in extra_keys -%}
    {%- assign destination = settings[key] -%}
    {%- if destination != blank -%}<a href="{{ destination.url }}"{% if page.id == destination.id %} aria-current="page"{% endif %}>{{ destination.title | escape }}</a>{%- endif -%}
  {%- endfor -%}
{%- endif -%}
