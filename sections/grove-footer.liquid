<footer class="grove-footer">
  <div class="grove-footer__top">
    <div>{% render 'grove-mark' %}<p class="grove-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>
    <div class="grove-footer__subscribe">
      <p>{{ section.settings.body | escape }}</p>
      {% if settings.demo_mode %}
        {% render 'demo-disabled-message', message_key: 'demo.newsletter_disabled' %}
      {% else %}
        {% form 'customer', id: 'GroveNewsletter' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="GroveEmail" class="visually-hidden">{{ 'footer.newsletter.email_label' | t }}</label>
          <div class="grove-email"><input id="GroveEmail" type="email" name="contact[email]" placeholder="{{ 'footer.newsletter.email_placeholder' | t }}" autocomplete="email" required><button type="submit" aria-label="{{ 'footer.newsletter.submit' | t }}">↗</button></div>
          {% if form.posted_successfully? %}<p role="status">{{ 'footer.newsletter.success' | t }}</p>{% endif %}
          {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        {% endform %}
      {% endif %}
    </div>
  </div>
  <a class="grove-footer__wordmark" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
  <div class="grove-footer__bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>
    <nav aria-label="{{ 'grove.footer_nav' | t }}"><a href="{{ routes.root_url }}#pantry">{{ 'grove.shop' | t }}</a><a href="{{ routes.root_url }}#story">{{ 'grove.story' | t }}</a>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</nav>
    <div class="grove-footer__controls">
      {% if localization.available_countries.size > 1 %}
        {% form 'localization', id: 'GroveCountryForm', class: 'grove-country-form' %}
          <label for="GroveCountryCode">{{ 'demo.country_label' | t | escape }}</label>
          <select id="GroveCountryCode" name="country_code" data-shopify-country-selector>
            {% for country in localization.available_countries %}
              <option value="{{ country.iso_code | escape }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name | escape }}{% if country.currency.iso_code %} ({{ country.currency.iso_code | escape }}){% endif %}</option>
            {% endfor %}
          </select>
          <noscript><button type="submit">{{ 'demo.country_label' | t | escape }}</button></noscript>
        {% endform %}
      {% endif %}
      <button type="button" data-kg-open-privacy-preferences data-unavailable-message="{{ 'demo.privacy_preferences_unavailable' | t | escape }}">{{ 'footer.legal.cookies' | t | escape }}</button>
      <span role="status" aria-live="polite" data-kg-privacy-preferences-status></span>
    </div>
    <span>{{ section.settings.signoff | escape }}</span>
  </div>
</footer>
{% schema %}
{"name":"Grove footer","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"LET’S KEEP GOOD COMPANY"},{"type":"text","id":"heading","label":"Heading","default":"A seat at our table."},{"type":"text","id":"body","label":"Newsletter description","default":"A few good things, now and then. Pantry inspiration, seasonal rituals, and stories worth sharing."},{"type":"text","id":"signoff","label":"Sign-off","default":"Rooted in the Mediterranean. Made for your everyday."}]}
{% endschema %}
