{%- comment -%}
  Build Your Pantry — multi-step quiz.
  5 questions (merchant-editable labels + option arrays), scored into one
  of 4 personas (merchant-editable name/description/collection/image).

  Gated by `KG_FF.isEnabled('pantry_quiz')` when the flag is defined —
  falls back to "always on" when the flag is missing. Answers remain in
  component memory for this page view and are never sent as telemetry.

  JavaScript progressively enables the quiz. The native browse link remains
  available without JavaScript or when configuration validation fails.
{%- endcomment -%}

{%- liquid
  assign questions_raw = block.settings.questions_json
  assign questions_json_attribute = questions_raw | escape
  if questions_raw == blank
    assign questions_raw = 'quiz.default_questions_json' | t
    assign questions_json_attribute = questions_raw | escape_once
  endif

  assign personas_raw = block.settings.personas_json
  assign personas_json_attribute = personas_raw | escape
  if personas_raw == blank
    assign personas_raw = 'quiz.default_personas_json' | t
    assign personas_json_attribute = personas_raw | escape_once
  endif

  assign heading = block.settings.heading
  if heading == blank
    assign heading = 'quiz.heading' | t
  endif
  assign intro = block.settings.intro
  if intro == blank
    assign intro = 'quiz.intro' | t
  endif
  assign back_label = block.settings.back_label
  if back_label == blank
    assign back_label = 'quiz.back' | t
  endif
  assign next_label = block.settings.next_label
  if next_label == blank
    assign next_label = 'quiz.next' | t
  endif
  assign submit_label = block.settings.submit_label
  if submit_label == blank
    assign submit_label = 'quiz.submit' | t
  endif
-%}

<kg-pantry-quiz
  class="kg-quiz"
  data-flag-name="pantry_quiz"
  data-next-label="{{ next_label | escape }}"
  data-submit-label="{{ submit_label | escape }}"
  data-result-label="{{ 'quiz.eyebrow_result' | t | escape }}"
  data-shop-label="{{ 'quiz.shop_cta' | t | escape }}"
  data-restart-label="{{ 'quiz.restart' | t | escape }}"
  data-invalid-message="{{ 'quiz.invalid_config' | t | escape }}"
  data-browse-label="{{ 'quiz.browse_all' | t | escape }}"
  data-fallback-url="{{ routes.all_products_collection_url | escape }}"
  {{ block.shopify_attributes }}
>
  {%- render 'quiz-config' -%}
  <template data-kg-quiz-questions data-json="{{ questions_json_attribute }}"></template>
  <template data-kg-quiz-personas data-json="{{ personas_json_attribute }}"></template>
  <template data-kg-quiz-scoring data-json="{{ block.settings.scoring_json | escape }}"></template>

  <div class="kg-quiz__shell" data-kg-quiz-shell hidden>
    <header class="kg-quiz__header stack-sm">
      {%- if heading != blank -%}
        <h2 class="h2 kg-quiz__heading">{{ heading | escape }}</h2>
      {%- endif -%}
      {%- if intro != blank -%}
        <p class="text-lg text-muted">{{ intro | escape }}</p>
      {%- endif -%}
      <div class="kg-quiz__progress" role="progressbar" aria-label="{{ heading | escape }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="kg-quiz__progress-fill" data-kg-quiz-progress></div>
      </div>
    </header>

    <div class="kg-quiz__stage" data-kg-quiz-stage aria-live="polite"></div>

    <footer class="kg-quiz__nav cluster" data-kg-quiz-nav>
      <button type="button" class="button button--ghost" data-kg-quiz-prev disabled>
        {{ back_label | escape }}
      </button>
      <button type="button" class="button button--primary" data-kg-quiz-next disabled>
        {{ next_label | escape }}
      </button>
    </footer>
  </div>

  <noscript>
    <div class="kg-quiz__noscript stack">
      <h2 class="h2">{{ heading | escape }}</h2>
      <p class="text-lg text-muted">{{ 'quiz.noscript' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
        {{ 'quiz.browse_all' | t }}
      </a>
    </div>
  </noscript>
</kg-pantry-quiz>

{% schema %}
{
  "name": "Pantry quiz",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text"
    },
    {
      "type": "textarea",
      "id": "questions_json",
      "label": "Questions (JSON)",
      "info": "Array of {label, options[]}. 5 entries expected. Leave empty for the default set."
    },
    {
      "type": "textarea",
      "id": "personas_json",
      "label": "Personas (JSON)",
      "info": "Array of four {name, slug, description, collection (handle), image (URL)} records. Leave empty for localized defaults. Images must use the storefront or configured Shopify CDN host."
    },
    {
      "type": "textarea",
      "id": "scoring_json",
      "label": "Scoring thresholds (JSON)",
      "default": "{\"thresholds\":[0.25,0.5,0.75]}",
      "info": "Three ascending normalized score thresholds used to map five question answers to four personas."
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back button label"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next button label"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Quiz result button label"
    }
  ]
}
{% endschema %}
