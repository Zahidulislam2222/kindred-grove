{%- comment -%}
  Shopify-native product model preview. The Shopify feature UI is requested only
  after the visitor activates the preview control. The poster remains useful
  when JavaScript or the optional feature loader is unavailable.
{%- endcomment -%}

{%- liquid
  assign model = null
  for media in product.media
    if media.media_type == 'model'
      assign model = media
      break
    endif
  endfor
-%}

{%- if model -%}
  <kg-model-viewer
    class="kg-model section"
    aria-label="{{ block.settings.heading | escape }}"
    data-unavailable-label="{{ block.settings.unavailable_label | escape }}"
    {{ block.shopify_attributes }}
  >
    {%- render 'model-viewer-config', block: block -%}
    <div class="container stack">
      <header class="stack-sm">
        <h2 class="h3">{{ block.settings.heading | escape }}</h2>
        {%- if block.settings.body != blank -%}
          <p class="text-muted">{{ block.settings.body | escape }}</p>
        {%- endif -%}
      </header>
      <div class="kg-model__viewer-wrap stack-sm">
        <img
          class="kg-model__poster kg-model__viewer"
          data-kg-model-poster
          src="{{ model.preview_image | image_url: width: 1200 }}"
          alt="{{ model.alt | default: product.title | escape }}"
          loading="lazy"
          width="1200"
          height="900"
        >
        <div id="KgModel-{{ section.id }}-{{ block.id }}" data-kg-model-viewer hidden></div>
        <template data-kg-model-template>{{ model | model_viewer_tag: image_size: '1200x', class: 'kg-model__viewer' }}</template>
      </div>
      <button type="button" class="button button--primary" data-kg-model-load aria-controls="KgModel-{{ section.id }}-{{ block.id }}" hidden>
        {{ block.settings.load_label | escape }}
      </button>
      <p class="text-muted" data-kg-model-status role="status" aria-live="polite">{{ block.settings.unavailable_label | escape }}</p>
      <noscript><p class="text-muted">{{ block.settings.noscript_label | escape }}</p></noscript>
    </div>
  </kg-model-viewer>
  <script src="{{ 'model-viewer.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "3D model viewer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See it in 3D" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Rotate and zoom the product in an interactive 3D preview." },
    { "type": "text", "id": "load_label", "label": "Load control label", "default": "Load 3D preview" },
    { "type": "text", "id": "loading_label", "label": "Loading status", "default": "Loading 3D preview…" },
    { "type": "text", "id": "unavailable_label", "label": "Unavailable status", "default": "Interactive 3D preview is unavailable. The product image remains available." },
    { "type": "text", "id": "noscript_label", "label": "No JavaScript message", "default": "Interactive 3D preview requires JavaScript. The product image remains available above." }
  ]
}
{% endschema %}
