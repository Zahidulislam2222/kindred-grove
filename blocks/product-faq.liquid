{%- comment -%}
  Merchant-editable Q&A accordion. Demo mode omits this block because its
  defaults include an unverified certification claim. Non-demo answers are
  plain escaped text and the JSON-LD safely escapes closing-script prefixes.
{%- endcomment -%}

{%- unless settings.demo_mode -%}
  {%- assign has_qas = false -%}
  {%- for i in (1..6) -%}
    {%- assign q_key = 'q_' | append: i -%}
    {%- assign a_key = 'a_' | append: i -%}
    {%- assign question = block.settings[q_key] -%}
    {%- assign answer = block.settings[a_key] -%}
    {%- if question != blank and answer != blank -%}
      {%- assign has_qas = true -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if has_qas -%}
    <section class="kg-faq section" aria-labelledby="KgFaqHeading-{{ block.id }}" {{ block.shopify_attributes }}>
      <div class="container stack">
        <header class="stack-sm">
          <h2 id="KgFaqHeading-{{ block.id }}" class="h3">{{ block.settings.heading | default: 'Questions' | escape }}</h2>
        </header>

        <ul class="kg-faq__list stack">
          {%- for i in (1..6) -%}
            {%- assign q_key = 'q_' | append: i -%}
            {%- assign a_key = 'a_' | append: i -%}
            {%- assign question = block.settings[q_key] -%}
            {%- assign answer = block.settings[a_key] -%}
            {%- if question != blank and answer != blank -%}
              <li class="kg-faq__item">
                <details class="kg-faq__details">
                  <summary class="kg-faq__summary">
                    <span>{{ question | escape }}</span>
                    <span class="kg-faq__chevron" aria-hidden="true">{% render 'icon', name: 'chevron-down', size: 16 %}</span>
                  </summary>
                  <div class="kg-faq__answer">{{ answer | escape | newline_to_br }}</div>
                </details>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- assign emitted_entity = false -%}
          {%- for i in (1..6) -%}
            {%- assign q_key = 'q_' | append: i -%}
            {%- assign a_key = 'a_' | append: i -%}
            {%- assign question = block.settings[q_key] -%}
            {%- assign answer = block.settings[a_key] | strip_html -%}
            {%- if question != blank and answer != blank -%}
              {%- if emitted_entity -%},{%- endif -%}
              {
                "@type": "Question",
                "name": {{ question | json | replace: '</', '<\/' }},
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": {{ answer | json | replace: '</', '<\/' }}
                }
              }
              {%- assign emitted_entity = true -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }
      </script>
    </section>
  {%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Product FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" },
    { "type": "header", "content": "Q1" },
    { "type": "text", "id": "q_1", "label": "Question", "default": "How is this oil different from supermarket olive oil?" },
    { "type": "textarea", "id": "a_1", "label": "Answer", "default": "Single-origin means every bottle comes from one grove's one harvest — not a blend. The oil is cold-pressed within four hours of harvest, which preserves the polyphenols and the grassy-peppery finish." },
    { "type": "header", "content": "Q2" },
    { "type": "text", "id": "q_2", "label": "Question", "default": "How do I store it?" },
    { "type": "textarea", "id": "a_2", "label": "Answer", "default": "Somewhere cool, dark, and dry. A pantry shelf is perfect. Use it within six months of opening for peak flavor." },
    { "type": "header", "content": "Q3 (optional — verify claims before publishing)" },
    { "type": "text", "id": "q_3", "label": "Question" },
    { "type": "textarea", "id": "a_3", "label": "Answer" },
    { "type": "header", "content": "Q4 (optional)" },
    { "type": "text", "id": "q_4", "label": "Question" },
    { "type": "textarea", "id": "a_4", "label": "Answer" },
    { "type": "header", "content": "Q5 (optional)" },
    { "type": "text", "id": "q_5", "label": "Question" },
    { "type": "textarea", "id": "a_5", "label": "Answer" },
    { "type": "header", "content": "Q6 (optional)" },
    { "type": "text", "id": "q_6", "label": "Question" },
    { "type": "textarea", "id": "a_6", "label": "Answer" }
  ]
}
{% endschema %}
