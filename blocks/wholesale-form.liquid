{%- comment -%}
  Wholesale / B2B inquiry form.

  Submits to Shopify's native `/contact` endpoint with a `form_type=contact`
  and a `contact[tags]=wholesale-inquiry` hidden input — every merchant's
  admin gets these under Customers → (inquiry email) with the wholesale tag.

  This remains Shopify's native contact form. The browser honeypot and
  optional in-memory cooldown are UX checks only; Shopify owns server-side
  form processing and any platform spam protections.
{%- endcomment -%}

{% if settings.demo_mode %}
  {% render 'demo-disabled-message', message_key: 'demo.contact_disabled' %}
{% else %}
<kg-wholesale-form
  class="kg-wholesale-form"
  data-submit-cooldown-ms="{{ block.settings.submit_cooldown_ms }}"
  data-submit-cooldown-message="{{ block.settings.submit_cooldown_message | escape }}"
  {{ block.shopify_attributes }}
>
  {% form 'contact',
     id: 'WholesaleInquiryForm',
     class: 'kg-wholesale-form__form',
     data-kg-form: 'wholesale'
  -%}
    <input type="hidden" name="contact[tags]" value="wholesale-inquiry">

    {%- if form.posted_successfully? -%}
      <p class="kg-wholesale-form__success" role="status">
        {{ 'wholesale.form.success' | t }}
      </p>
    {%- endif -%}

    {%- if form.errors -%}
      <ul class="kg-wholesale-form__errors" role="alert">
        {%- for field in form.errors -%}
          <li>{{ form.errors.messages[field] | escape }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="kg-wholesale-form__grid stack">
      {% assign field_label_wholesale_form_name = 'wholesale.form.name' | t %}
{%
        render 'form-field',
        id: 'wholesale-name',
        name: 'contact[name]',
        label: field_label_wholesale_form_name,
        required: true,
        autocomplete: 'name'
      %}

      {% assign field_label_wholesale_form_email = 'wholesale.form.email' | t %}
{%
        render 'form-field',
        id: 'wholesale-email',
        type: 'email',
        name: 'contact[email]',
        label: field_label_wholesale_form_email,
        required: true,
        autocomplete: 'email'
      %}

      {% assign field_label_wholesale_form_business = 'wholesale.form.business' | t %}
{%
        render 'form-field',
        id: 'wholesale-business',
        name: 'contact[company]',
        label: field_label_wholesale_form_business,
        required: true,
        autocomplete: 'organization'
      %}

      <div class="form-field">
        <label for="wholesale-volume" class="form-field__label form-field__label--required">
          {{ 'wholesale.form.volume' | t }}
        </label>
        <select id="wholesale-volume" name="contact[volume]" class="select" required aria-required="true">
          <option value="">{{ 'wholesale.form.volume_placeholder' | t }}</option>
          <option value="1-5">{{ 'wholesale.form.volume_1_5' | t }}</option>
          <option value="6-20">{{ 'wholesale.form.volume_6_20' | t }}</option>
          <option value="21-100">{{ 'wholesale.form.volume_21_100' | t }}</option>
          <option value="100+">{{ 'wholesale.form.volume_100_plus' | t }}</option>
        </select>
      </div>

      {% assign field_label_wholesale_form_message = 'wholesale.form.message' | t %}
{%
        render 'form-field',
        id: 'wholesale-message',
        type: 'textarea',
        name: 'contact[body]',
        label: field_label_wholesale_form_message,
        required: true,
        rows: 5
      %}
    </div>

    {% render 'form-honeypot', name: 'wholesale_website' %}

    <div class="kg-wholesale-form__submit">
      <p class="kg-wholesale-form__privacy text-sm text-muted">
        {{ 'wholesale.form.privacy_html' | t }}
      </p>
      <button type="submit" class="button button--primary button--lg kg-wholesale-form__button" data-kg-submit>
        {{ 'wholesale.form.submit' | t }}
      </button>
    </div>
  {%- endform %}
</kg-wholesale-form>
{% endif %}

{% schema %}
{
  "name": "Wholesale form",
  "settings": [
    {
      "type": "range",
      "id": "submit_cooldown_ms",
      "label": "Optional browser-side submit cooldown",
      "min": 0,
      "max": 9000,
      "step": 1000,
      "default": 0,
      "unit": "ms",
      "info": "User-experience control only. It is not server-side spam protection."
    },
    {
      "type": "text",
      "id": "submit_cooldown_message",
      "label": "Cooldown message",
      "default": "Please wait {seconds} seconds before trying again.",
      "info": "Displayed with the remaining time. This is a browser-only message."
    }
  ],
  "presets": [
    { "name": "Wholesale form" }
  ]
}
{% endschema %}
