# Kindred Grove — Environment Variables Template
#
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.
#
# For CI, equivalent values live in GitHub Actions Secrets (encrypted);
# see docs/TESTING.md for each workflow prerequisite.

# =========================================
# Shopify — dev / staging / production themes
# =========================================
# <shop>.myshopify.com domain of the dev store
SHOPIFY_STORE_URL=
# Canonical *.myshopify.com host for CI preview validation.
# When set, PREVIEW_URL must target this exact host; omit for local custom-domain preview.
SHOPIFY_STORE=
# Numeric theme IDs (from `shopify theme list` or admin UI)
SHOPIFY_THEME_ID_DEV=
SHOPIFY_THEME_ID_STAGING=
SHOPIFY_THEME_ID_PRODUCTION=

# Theme Access app password (shptka_...) — CLI auth for non-interactive pushes
SHOPIFY_CLI_THEME_TOKEN=

# Optional credentials used by the manual Shopify Lighthouse CI action
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Playwright target; required for test/e2e runs. HTTPS is required except localhost.
BASE_URL=
# Optional Shopify preview URL; must use the same origin as BASE_URL.
PREVIEW_URL=
# Optional two-letter country selected through the native localization form by commerce tests.
# The country must be available in the store; format validation alone does not prove availability.
TEST_COUNTRY=
# Storefront password — optional for unlocked previews, required if a password gate appears.
# STORE_PASSWORD is accepted as a legacy alias; set at most one (or set both identically).
SHOPIFY_STORE_PASSWORD=
# Legacy alias for SHOPIFY_STORE_PASSWORD; do not set conflicting values.
STORE_PASSWORD=

# =========================================
# Visual Regression — Percy
# =========================================
# Project token (web_...) from percy.io → project → Settings → General
PERCY_TOKEN=

# =========================================
# CI / Deployment
# =========================================
# Optional — enables Lighthouse CI PR comments.
# Install from https://github.com/apps/lighthouse-ci
LHCI_GITHUB_APP_TOKEN=

# Cloudflare/GitHub CLI authentication is managed by the installed CLIs.
# Unused future vendor keys are intentionally absent; do not provision them.

# Optional local scanner executable; omit to resolve gitleaks from PATH.
GITLEAKS_BIN=
# Runner context; GitHub supplies this automatically.
CI=false
