<section class="grove-search">
  <header><p class="grove-eyebrow">{{ 'grove.shop' | t }}</p><h1>{{ 'storefront.search_title' | t }}</h1></header>
  <form action="{{ routes.search_url }}" method="get" role="search" class="grove-search__form">
    <label for="GroveSearch" class="visually-hidden">{{ 'storefront.search_label' | t }}</label>
    <input id="GroveSearch" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'storefront.search_placeholder' | t }}" required>
    <button class="grove-button grove-button--olive" type="submit">{{ 'storefront.search_submit' | t }} <span aria-hidden="true">↗</span></button>
  </form>
  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p role="status">{{ 'storefront.search_empty' | t }}</p><a class="grove-text-link" href="{{ routes.all_products_collection_url }}">{{ 'storefront.browse_pantry' | t }} ↗</a>
    {% else %}
      <p role="status">{{ 'storefront.search_count' | t: count: search.results_count, terms: search.terms | escape }}</p>
      {% paginate search.results by 12 %}
        <ul class="grove-search__results">
          {% for item in search.results %}
            <li>{% if item.object_type == 'product' %}{% render 'grove-card', product: item, index: forloop.index %}{% else %}<article class="grove-search__editorial"><h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2><p>{{ item.content | strip_html | truncatewords: 30 }}</p></article>{% endif %}</li>
          {% endfor %}
        </ul>
        {% if paginate.pages > 1 %}<nav class="grove-pagination" aria-label="{{ 'blog.pagination' | t }}">{{ paginate | default_pagination }}</nav>{% endif %}
      {% endpaginate %}
    {% endif %}
  {% endif %}
</section>
