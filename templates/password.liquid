<main class="grove-access">
  <div class="grove-access__image"><img src="{{ 'grove-hero.webp' | asset_url }}" width="1536" height="864" alt="" loading="eager"></div>
  <div class="grove-access__content">
    {% render 'grove-mark' %}<p class="grove-eyebrow">{{ 'storefront.access_eyebrow' | t }}</p><h1>{{ 'storefront.access_heading' | t }}</h1><p>{{ 'storefront.access_body' | t }}</p>
    {% form 'storefront_password' %}
      {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <label for="GrovePassword">{{ 'storefront.access_password' | t }}</label><input id="GrovePassword" type="password" name="password" autocomplete="current-password" required>
      <button class="grove-button grove-button--olive" type="submit">{{ 'storefront.access_submit' | t }} <span aria-hidden="true">↗</span></button>
    {% endform %}
  </div>
</main>
